# =====================================================================
# AIFlow Configuration — copy this file to .env and fill in values
# =====================================================================

# ─── Optional text provider ──────────────────────────────────────────
# Gemini is required only by adapters that call Gemini, not for audio/startup.
AIFLOW_GEMINI_API_KEY=

# Google Flow plan (Pro or Ultra)
AIFLOW_FLOW_PLAN=Pro

# ─── Server ──────────────────────────────────────────────────────────
AIFLOW_HOST=127.0.0.1
AIFLOW_PORT=8101
AIFLOW_WS_PORT=9223
AIFLOW_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
AIFLOW_DATA_DIR=./storage          # Relative to app/ or absolute path
AIFLOW_DEBUG=false                 # true → reload + verbose

# ─── Google Gemini ────────────────────────────────────────────────────
AIFLOW_GEMINI_MODEL=gemini-2.5-flash
AIFLOW_GEMINI_VISION_MODEL=gemini-2.5-flash
AIFLOW_GEMINI_TIMEOUT=60           # seconds
AIFLOW_GEMINI_MAX_RETRIES=3

# ─── Google Flow (Veo 3) ─────────────────────────────────────────────
# Token is captured automatically by the extension — no manual key needed
AIFLOW_FLOW_DEFAULT_QUALITY=fast   # lite | fast | quality
AIFLOW_FLOW_DEFAULT_ASPECT=9:16    # 9:16 | 16:9
AIFLOW_FLOW_DEFAULT_DURATION=8     # seconds (legacy alias)
AIFLOW_FLOW_CLIP_DURATION=8.0     # max seconds per Veo3 clip; increase if Veo3 supports longer

# ─── Remote TTS ─────────────────────────────────────────────────────
AIFLOW_TTS_PRIMARY=remote
AIFLOW_TTS_REMOTE_DEFAULT_VOICE=af_heart
AIFLOW_TTS_LANGUAGE=en
# Enter Colab URL/token in /connections. Never commit a session token.

# Local Whisper is disabled. Remote worker v1 provides TTS only.

# ─── FFmpeg / Aria2 paths ────────────────────────────────────────────
# Leave empty → auto-detect vendor/ffmpeg.exe then PATH
AIFLOW_FFMPEG_PATH=
AIFLOW_FFPROBE_PATH=
AIFLOW_ARIA2C_PATH=

# ─── Cookie source (Phase 4.5) ───────────────────────────────────────
AIFLOW_COOKIES_SOURCE=auto         # auto (Chrome) | manual_file
AIFLOW_COOKIES_BROWSER=chrome      # chrome | firefox | edge | brave

# ─── Pipeline limits ─────────────────────────────────────────────────
AIFLOW_MAX_SCENES_PER_PROJECT=50
AIFLOW_MAX_VIDEO_DURATION_SEC=600
AIFLOW_VEO3_DAILY_BUDGET_CREDITS=100

# ─── Privacy ─────────────────────────────────────────────────────────
AIFLOW_TELEMETRY_ENABLED=false
AIFLOW_CRASH_REPORTING=false
