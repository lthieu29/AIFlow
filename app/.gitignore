# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual env
.venv/
venv/

# Storage (runtime data + secrets)
storage/
!storage/.gitkeep

# Secrets
.env
.env.local
*.pem
*.key

# Cookies (tránh leak personal cookies)
storage/cookies/

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
.DS_Store

# Build
dist/
build/
*.egg-info/

# UI
ui/node_modules/
ui/dist/

# Logs
*.log

# Chrome-generated extension cache (rules.json is the source)
/extension/_metadata/

# Downloaded runtime dependencies; keep setup scripts and documentation
/vendor/*.exe
/vendor/playwright/
/vendor/visual_layer/*.min.js
